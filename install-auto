#!/bin/sh
set -eu

REPO="${COMMONVPN_REPOSITORY:-ASTRACAT2022/common-vpn-for-router}"
BASE_URL="${COMMONVPN_RELEASE_BASE_URL:-}"
VERSION="${COMMONVPN_VERSION:-latest}"
XRAY_VERSION="${COMMONVPN_XRAY_VERSION:-v26.6.27}"
XRAY_VERSION_NUMBER="${XRAY_VERSION#v}"
ASSETS=/tmp/common-vpn-runtime
PORT="${COMMONVPN_PORT:-8787}"
case "$XRAY_VERSION" in v[0-9]* ) ;; *) printf '%s\n' "Common VPN: некорректная версия Xray: $XRAY_VERSION" >&2; exit 1;; esac
case "$XRAY_VERSION" in *[!A-Za-z0-9._-]*) printf '%s\n' "Common VPN: некорректная версия Xray: $XRAY_VERSION" >&2; exit 1;; esac
say() { printf '%s\n' "$*"; }
fail() { say "Common VPN: $*" >&2; exit 1; }
copy_executable() {
  target_dir="$(dirname "$2")"
  COPY_TMP="$2.tmp.$$"
  mkdir -p "$target_dir" || return 1
  cp "$1" "$COPY_TMP" || { rm -f "$COPY_TMP"; COPY_TMP=""; return 1; }
  chmod 0755 "$COPY_TMP" || { rm -f "$COPY_TMP"; COPY_TMP=""; return 1; }
  mv -f "$COPY_TMP" "$2" || { rm -f "$COPY_TMP"; COPY_TMP=""; return 1; }
  COPY_TMP=""
}

[ "$(id -u)" -eq 0 ] || fail "запусти установщик от root."
case "$REPO" in */*/*|"") fail "укажи репозиторий в формате owner/repository.";; esac
PATH="/opt/bin:/opt/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH
TMP="$(mktemp -d "${TMPDIR:-/tmp}/common-vpn.XXXXXX")"
XRAY_STAGE=""
COPY_TMP=""
cleanup() {
  [ -z "$XRAY_STAGE" ] || rm -f "$XRAY_STAGE"
  [ -z "$COPY_TMP" ] || rm -f "$COPY_TMP"
  rm -rf "$TMP"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -f /etc/openwrt_release ]; then
  PLATFORM=openwrt; APP=/usr/bin/common-vpn; XRAY=/usr/bin/xray
  CONFIG=/etc/common-vpn; DATA=/etc/common-vpn/data; SERVICE=/etc/init.d/common-vpn
elif [ -d /opt/etc ] && [ -d /opt/bin ]; then
  PLATFORM=entware; APP=/opt/bin/common-vpn; XRAY=/opt/bin/xray
  CONFIG=/opt/etc/common-vpn; DATA=/opt/var/lib/common-vpn; SERVICE=/opt/etc/init.d/S95common-vpn
else
  PLATFORM=linux; APP=/usr/local/bin/common-vpn; XRAY=/usr/local/bin/xray
  CONFIG=/etc/common-vpn; DATA=/var/lib/common-vpn; SERVICE=/etc/systemd/system/common-vpn.service
fi

if [ "$PLATFORM" != openwrt ]; then ASSETS="$CONFIG/assets"; fi

case "$(uname -m)" in
  x86_64|amd64) APP_ARCH=amd64; XRAY_ARCH=linux-64 ;;
  aarch64|arm64) APP_ARCH=arm64; XRAY_ARCH=linux-arm64-v8a ;;
  armv7l|armv7*) APP_ARCH=armv7; XRAY_ARCH=linux-arm32-v7a ;;
  mips) APP_ARCH=mips; XRAY_ARCHS="linux-mips32 linux-mips32-softfloat" ;;
  mipsel|mipsle) APP_ARCH=mipsle; XRAY_ARCHS="linux-mips32le linux-mips32le-softfloat" ;;
  *) fail "неподдерживаемая архитектура $(uname -m); нужны amd64, arm64, armv7, mips или mipsle." ;;
esac
if [ -z "${XRAY_ARCHS:-}" ]; then XRAY_ARCHS="$XRAY_ARCH"; fi

if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
  fail "для загрузки нужны curl или wget."
fi
fetch() {
  if command -v curl >/dev/null 2>&1 && curl --version >/dev/null 2>&1; then
    if curl -fL --retry 2 --connect-timeout 15 --max-time 180 -o "$2" "$1"; then return 0; fi
  fi
  if command -v wget >/dev/null 2>&1; then wget -O "$2" "$1"; return $?; fi
  return 1
}
check_url() {
  if command -v curl >/dev/null 2>&1 && curl --version >/dev/null 2>&1 && curl -fsS --max-time 2 "$1" >/dev/null; then return 0; fi
  if command -v wget >/dev/null 2>&1; then wget -q -T 2 -O /dev/null "$1"; return $?; fi
  return 1
}
available_bytes() {
  df -Pk "$1" 2>/dev/null | awk 'NR > 1 { available = $4 } END { if (available ~ /^[0-9]+$/) printf "%.0f", available * 1024 }'
}
has_space() {
  space_available="$(available_bytes "$(dirname "$1")")"
  case "$space_available" in ''|*[!0-9]*) return 1;; esac
  [ "$space_available" -ge "$2" ] 2>/dev/null
}
xray_version() {
  "$1" version 2>/dev/null | awk 'NR == 1 { print $2; exit }'
}
install_assets() {
  mkdir -p "$ASSETS" || return 1
  for asset in geoip.dat geosite.dat; do
    asset_stage="$ASSETS/.$asset.$$"
    if ! unzip -p "$1" "$asset" > "$asset_stage" || [ ! -s "$asset_stage" ]; then
      rm -f "$asset_stage"
      return 1
    fi
    mv -f "$asset_stage" "$ASSETS/$asset" || return 1
  done
}
if [ -z "$BASE_URL" ]; then
  if [ "$VERSION" = latest ]; then BASE_URL="https://github.com/$REPO/releases/latest/download"
  else BASE_URL="https://github.com/$REPO/releases/download/$VERSION"; fi
fi

[ -c /dev/net/tun ] || {
  if [ "$PLATFORM" = openwrt ]; then
    if command -v apk >/dev/null 2>&1; then apk update && apk add kmod-tun
    elif command -v opkg >/dev/null 2>&1; then opkg update && opkg install kmod-tun; fi
    if command -v modprobe >/dev/null 2>&1; then modprobe tun || true; fi
  fi
  [ -c /dev/net/tun ] || fail "TUN выключен: установи модуль ядра и создай /dev/net/tun."
}

LAN_IP=""
if command -v ip >/dev/null 2>&1; then
  LAN_IP="$(ip -o -4 addr show scope global 2>/dev/null | awk '
    { split($4,a,"/"); ip=a[1]; if (ip ~ /^10\./ || ip ~ /^192\.168\./ || ip ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) { if ($2 ~ /^br[-0-9]/ || $2 ~ /^lan/) { print ip; found=1; exit } if (fallback == "") fallback=ip } }
    END { if (!found && fallback != "") print fallback }
  ')"
fi
if [ -z "$LAN_IP" ]; then LAN_IP=127.0.0.1; say "LAN IPv4 не найден; панель будет локальной."; fi
LISTEN="$LAN_IP:$PORT"
say "Обнаружено: $PLATFORM / $(uname -m), адрес панели: http://$LISTEN/"

APP_ARCHIVE="$TMP/common-vpn.tar.gz"
fetch "$BASE_URL/common-vpn-linux-$APP_ARCH.tar.gz" "$APP_ARCHIVE" || fail "не удалось скачать common-vpn-linux-$APP_ARCH из релиза $REPO; проверь доступ к GitHub и наличие файла в релизе."
tar -tzf "$APP_ARCHIVE" | grep -qx common-vpn || fail "неожиданное содержимое архива common-vpn."
tar -xzf "$APP_ARCHIVE" -C "$TMP" common-vpn
rm -f "$APP_ARCHIVE"
[ -s "$TMP/common-vpn" ] || fail "в архиве нет common-vpn."

ALT_XRAY=""
XRAY_RAM_MODE=0
XRAY_ARCH_RUNTIME=""
XRAY_FILE_RUNTIME=""
case "$PLATFORM" in
  openwrt) ALT_XRAY=/opt/bin/xray ;;
  entware) ALT_XRAY=/usr/bin/xray ;;
  linux) [ ! -d /opt ] || ALT_XRAY=/opt/bin/xray ;;
esac
INSTALLED_XRAY_VERSION="$(xray_version "$XRAY" || true)"
if [ "$INSTALLED_XRAY_VERSION" != "$XRAY_VERSION_NUMBER" ] && [ -n "$ALT_XRAY" ] && [ -x "$ALT_XRAY" ]; then
  ALT_XRAY_VERSION="$(xray_version "$ALT_XRAY" || true)"
  if [ "$ALT_XRAY_VERSION" = "$XRAY_VERSION_NUMBER" ]; then
    XRAY="$ALT_XRAY"
    INSTALLED_XRAY_VERSION="$ALT_XRAY_VERSION"
  fi
fi
if [ "$PLATFORM" = openwrt ] && [ "$INSTALLED_XRAY_VERSION" != "$XRAY_VERSION_NUMBER" ] && [ -x /tmp/common-vpn-runtime/xray ] && [ "$(xray_version /tmp/common-vpn-runtime/xray || true)" = "$XRAY_VERSION_NUMBER" ]; then
  XRAY=/tmp/common-vpn-runtime/xray
  INSTALLED_XRAY_VERSION="$XRAY_VERSION_NUMBER"
  XRAY_RAM_MODE=1
  XRAY_ARCH_RUNTIME="${XRAY_ARCH:-$(printf '%s' "$XRAY_ARCHS" | awk '{print $1}')}"
  XRAY_FILE_RUNTIME=xray
fi
if [ "$INSTALLED_XRAY_VERSION" != "$XRAY_VERSION_NUMBER" ]; then
  mkdir -p "$(dirname "$XRAY")" || fail "не удалось создать каталог для Xray: $(dirname "$XRAY")."
  if ! command -v unzip >/dev/null 2>&1; then
    if command -v busybox >/dev/null 2>&1 && busybox --list 2>/dev/null | grep -qx unzip; then
      unzip() { busybox unzip "$@"; }
    elif command -v opkg >/dev/null 2>&1; then opkg update && opkg install unzip
    elif command -v apk >/dev/null 2>&1; then apk update && apk add unzip
    elif command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y unzip
    else fail "не нашёл unzip/BusyBox unzip или поддерживаемый пакетный менеджер."; fi
  fi
  say "Установка Xray Core $XRAY_VERSION (системные TUN-маршруты для Linux)."
  XRAY_READY=0
  XRAY_LAST_PATH="$XRAY"
  XRAY_LAST_FREE="$(available_bytes "$(dirname "$XRAY")")"
  XRAY_LAST_SIZE=0
  for XRAY_ARCH in $XRAY_ARCHS; do
    XRAY_ZIP="$TMP/xray.zip"
    rm -f "$XRAY_ZIP"
    if ! fetch "https://github.com/XTLS/Xray-core/releases/download/$XRAY_VERSION/Xray-$XRAY_ARCH.zip" "$XRAY_ZIP"; then rm -f "$XRAY_ZIP"; continue; fi
    XRAY_FILE="$(unzip -l "$XRAY_ZIP" | awk '$4 ~ /(^|\/)xray$/ { print $4; exit }')"
    XRAY_SIZE="$(unzip -l "$XRAY_ZIP" | awk '$4 ~ /(^|\/)xray$/ { print $1; exit }')"
    case "$XRAY_SIZE" in ''|*[!0-9]*) rm -f "$XRAY_ZIP"; continue;; esac
    case "$XRAY_FILE" in ''|*[!A-Za-z0-9_./-]*) rm -f "$XRAY_ZIP"; continue;; esac
    # Validate the selected member's CRC without creating another temporary
    # binary before an in-place replacement may have to free flash storage.
    if ! unzip -p "$XRAY_ZIP" "$XRAY_FILE" >/dev/null; then rm -f "$XRAY_ZIP"; continue; fi

    # Leave a little room for filesystem metadata. Flash installs extract
    # straight to their target; the RAM fallback checks free space after the
    # ZIP download, so tmpfs can hold both archive and extracted core.
    XRAY_REQUIRED=$((XRAY_SIZE + 65536))
    XRAY_LAST_PATH="$XRAY"
    XRAY_LAST_FREE="$(available_bytes "$(dirname "$XRAY")")"
    XRAY_LAST_SIZE="$XRAY_SIZE"
    if ! has_space "$XRAY" "$XRAY_REQUIRED"; then
      if [ -n "$ALT_XRAY" ] && [ "$ALT_XRAY" != "$XRAY" ] && { [ -d "$(dirname "$ALT_XRAY")" ] || mkdir -p "$(dirname "$ALT_XRAY")" 2>/dev/null; } && has_space "$ALT_XRAY" "$XRAY_REQUIRED"; then
        say "Во внутренней памяти мало места; Xray будет установлен в $ALT_XRAY."
        XRAY="$ALT_XRAY"
        XRAY_LAST_PATH="$XRAY"
        XRAY_LAST_FREE="$(available_bytes "$(dirname "$XRAY")")"
      elif [ "$PLATFORM" = openwrt ] && mkdir -p /tmp/common-vpn-runtime && has_space /tmp/common-vpn-runtime/xray "$XRAY_REQUIRED"; then
        XRAY=/tmp/common-vpn-runtime/xray
        XRAY_RAM_MODE=1
        XRAY_ARCH_RUNTIME="$XRAY_ARCH"
        XRAY_FILE_RUNTIME="$XRAY_FILE"
        XRAY_LAST_PATH=/tmp/common-vpn-runtime
        XRAY_LAST_FREE="$(available_bytes /tmp/common-vpn-runtime)"
        say "Во flash недостаточно места; Xray будет работать из RAM. После перезагрузки он скачается заново."
      elif [ -f "$XRAY" ]; then
        rm -f "$XRAY_ZIP"
        continue
      else
        rm -f "$XRAY_ZIP"
        continue
      fi
    fi

    XRAY_STAGE="$(dirname "$XRAY")/.xray.new.$$"
    if ! install_assets "$XRAY_ZIP" || ! unzip -p "$XRAY_ZIP" "$XRAY_FILE" > "$XRAY_STAGE"; then
      rm -f "$XRAY_ZIP" "$XRAY_STAGE"
      XRAY_STAGE=""
      continue
    fi
    rm -f "$XRAY_ZIP"
    chmod 0755 "$XRAY_STAGE" || { rm -f "$XRAY_STAGE"; XRAY_STAGE=""; continue; }
    if [ "$(xray_version "$XRAY_STAGE" || true)" != "$XRAY_VERSION_NUMBER" ]; then
      rm -f "$XRAY_STAGE"
      XRAY_STAGE=""
      continue
    fi
    if ! mv -f "$XRAY_STAGE" "$XRAY"; then rm -f "$XRAY_STAGE"; XRAY_STAGE=""; continue; fi
    XRAY_STAGE=""
    XRAY_READY=1
    break
  done
  [ "$XRAY_READY" -eq 1 ] || fail "не удалось установить Xray: в $XRAY_LAST_PATH доступно ${XRAY_LAST_FREE:-неизвестно} байт, нужно около $XRAY_LAST_SIZE байт плюс место для файла. Существующий Xray не изменён; освободи место или подключи накопитель в /opt. Временные файлы установщика удалены."
else
  say "Xray Core $XRAY_VERSION уже установлен."
fi
if [ ! -s "$ASSETS/geoip.dat" ] || [ ! -s "$ASSETS/geosite.dat" ]; then
  if ! command -v unzip >/dev/null 2>&1; then
    if command -v busybox >/dev/null 2>&1 && busybox --list 2>/dev/null | grep -qx unzip; then
      unzip() { busybox unzip "$@"; }
    elif command -v opkg >/dev/null 2>&1; then opkg update && opkg install unzip
    elif command -v apk >/dev/null 2>&1; then apk update && apk add unzip
    elif command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y unzip
    else fail "для Xray geo-файлов нужен unzip."; fi
  fi
  assets_ready=0
  for asset_arch in $XRAY_ARCHS; do
    asset_zip="$TMP/xray-assets.zip"
    if fetch "https://github.com/XTLS/Xray-core/releases/download/$XRAY_VERSION/Xray-$asset_arch.zip" "$asset_zip" && install_assets "$asset_zip"; then
      assets_ready=1
      rm -f "$asset_zip"
      break
    fi
    rm -f "$asset_zip"
  done
  [ "$assets_ready" -eq 1 ] || fail "не удалось получить geoip.dat и geosite.dat для правил маршрутизации."
fi

mkdir -p "$CONFIG" "$DATA"
chmod 0700 "$CONFIG" "$DATA"
if [ "$PLATFORM" = openwrt ] && [ ! -f "$DATA/state.json" ] && [ -f /var/lib/common-vpn/state.json ]; then
  cp /var/lib/common-vpn/state.json "$DATA/state.json"
  chmod 0600 "$DATA/state.json"
fi
copy_executable "$TMP/common-vpn" "$APP" || fail "не удалось установить Common VPN в $APP."
rm -f "$TMP/common-vpn"

if [ "$PLATFORM" = openwrt ]; then
  # Permit LAN forwarding into the TUN, without exposing the panel to WAN.
  uci set firewall.commonvpn=zone
  uci set firewall.commonvpn.name='commonvpn'
  uci set firewall.commonvpn.device='commonvpn0'
  uci set firewall.commonvpn.input='REJECT'
  uci set firewall.commonvpn.output='ACCEPT'
  uci set firewall.commonvpn.forward='REJECT'
  uci set firewall.commonvpn.mtu_fix='1'
  uci set firewall.commonvpn_lan=forwarding
  uci set firewall.commonvpn_lan.src='lan'
  uci set firewall.commonvpn_lan.dest='commonvpn'
  uci commit firewall
  /etc/init.d/firewall reload || fail "не удалось применить разрешение LAN → VPN."
  cat > /usr/bin/common-vpn-xray-cache <<'CACHE_EOF'
#!/bin/sh
set -u

XRAY_VERSION="$1"
XRAY_ARCH="$2"
XRAY_FILE="$3"
RUNTIME=/tmp/common-vpn-runtime
XRAY="$4"
ZIP="$RUNTIME/xray.zip"
STAGE="$RUNTIME/.xray.new.$$"

cleanup() { rm -f "$ZIP" "$STAGE" "$RUNTIME/.geoip.dat.$$" "$RUNTIME/.geosite.dat.$$"; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

xray_version() { "$1" version 2>/dev/null | awk 'NR == 1 { print $2; exit }'; }
fetch() {
  if command -v curl >/dev/null 2>&1 && curl --version >/dev/null 2>&1; then
    if curl -fL --retry 2 --connect-timeout 15 --max-time 180 -o "$2" "$1"; then return 0; fi
  fi
  if command -v wget >/dev/null 2>&1; then wget -q -T 180 -O "$2" "$1"; return $?; fi
  return 1
}
extract_xray() {
  if command -v unzip >/dev/null 2>&1; then unzip -p "$1" "$2"
  elif command -v busybox >/dev/null 2>&1 && busybox --list 2>/dev/null | grep -qx unzip; then busybox unzip -p "$1" "$2"
  else return 1; fi
}

mkdir -p "$RUNTIME"
while :; do
  if [ -x "$XRAY" ] && [ "$(xray_version "$XRAY")" = "$XRAY_VERSION" ] && [ -s "$RUNTIME/geoip.dat" ] && [ -s "$RUNTIME/geosite.dat" ]; then
    echo "Common VPN: Xray $XRAY_VERSION and geo assets ready."
    while :; do sleep 3600; done
  fi
  rm -f "$ZIP" "$STAGE"
  if fetch "https://github.com/XTLS/Xray-core/releases/download/v$XRAY_VERSION/Xray-$XRAY_ARCH.zip" "$ZIP" \
    && extract_xray "$ZIP" geoip.dat > "$RUNTIME/.geoip.dat.$$" \
    && extract_xray "$ZIP" geosite.dat > "$RUNTIME/.geosite.dat.$$" \
    && [ -s "$RUNTIME/.geoip.dat.$$" ] && [ -s "$RUNTIME/.geosite.dat.$$" ]; then
    core_ready=0
    if [ -x "$XRAY" ] && [ "$(xray_version "$XRAY")" = "$XRAY_VERSION" ]; then
      core_ready=1
    elif extract_xray "$ZIP" "$XRAY_FILE" > "$STAGE" && chmod 0755 "$STAGE" \
      && [ "$(xray_version "$STAGE")" = "$XRAY_VERSION" ] && mv -f "$STAGE" "$XRAY"; then
      core_ready=1
    fi
    if [ "$core_ready" -eq 1 ] \
      && mv -f "$RUNTIME/.geoip.dat.$$" "$RUNTIME/geoip.dat" \
      && mv -f "$RUNTIME/.geosite.dat.$$" "$RUNTIME/geosite.dat"; then
      rm -f "$ZIP"
      echo "Common VPN: Xray $XRAY_VERSION and geo assets restored."
      while :; do sleep 3600; done
    fi
  fi
  rm -f "$ZIP" "$STAGE" "$RUNTIME/.geoip.dat.$$" "$RUNTIME/.geosite.dat.$$"
  echo "Common VPN: Xray download failed; retrying in 30 seconds." >&2
  sleep 30
done
CACHE_EOF
  chmod 0755 /usr/bin/common-vpn-xray-cache
  cat > "$SERVICE" <<EOF
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
start_service() {
  procd_open_instance xray-cache
  procd_set_param command /usr/bin/common-vpn-xray-cache "$XRAY_VERSION_NUMBER" "${XRAY_ARCH_RUNTIME:-$(printf '%s' "$XRAY_ARCHS" | awk '{print $1}')}" "${XRAY_FILE_RUNTIME:-xray}" "$XRAY"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
  procd_open_instance client
  procd_set_param env XRAY_LOCATION_ASSET=$ASSETS
  procd_set_param command $APP -listen $LISTEN -config-dir $CONFIG -data-dir $DATA -xray $XRAY -tun=true
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
EOF
  chmod 0755 "$SERVICE"
  "$SERVICE" enable
  "$SERVICE" restart || "$SERVICE" start
elif [ "$PLATFORM" = entware ]; then
  mkdir -p /opt/var/run /opt/var/log "$(dirname "$SERVICE")"
  cat > "$SERVICE" <<EOF
#!/bin/sh
case "\$1" in
  start) XRAY_LOCATION_ASSET=$ASSETS $APP -listen $LISTEN -config-dir $CONFIG -data-dir $DATA -xray $XRAY -tun=true >>/opt/var/log/common-vpn.log 2>&1 & echo \$! >/opt/var/run/common-vpn.pid ;;
  stop) [ ! -s /opt/var/run/common-vpn.pid ] || kill "\$(cat /opt/var/run/common-vpn.pid)" 2>/dev/null || true; rm -f /opt/var/run/common-vpn.pid ;;
  restart) "\$0" stop; "\$0" start ;;
  *) echo "Usage: \$0 {start|stop|restart}"; exit 1 ;;
esac
EOF
  chmod 0755 "$SERVICE"
  "$SERVICE" restart
else
  cat > "$SERVICE" <<EOF
[Unit]
Description=Common Network VPN client
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
Environment=XRAY_LOCATION_ASSET=$ASSETS
ExecStart=$APP -listen $LISTEN -config-dir $CONFIG -data-dir $DATA -xray $XRAY -tun=true
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
[Install]
  WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable common-vpn.service
  systemctl restart common-vpn.service || systemctl start common-vpn.service
fi

tries=0
until check_url "http://$LISTEN/api/system/info"; do
  tries=$((tries + 1))
  [ "$tries" -lt 15 ] || fail "служба не ответила на проверочный запрос; проверь журнал службы и TUN."
  sleep 1
done
say ""
say "Common Network VPN установлен; веб-панель и API отвечают."
say "На устройстве в локальной сети открой: http://$LISTEN/"
say "Добавь подписку и включи «Авто · лучший сервер»."
if [ "$PLATFORM" = openwrt ] && [ "$XRAY_RAM_MODE" -eq 1 ]; then
  say "Xray работает из RAM и скачивается после каждой перезагрузки; для этого нужен доступ к GitHub."
fi
say "Не открывай порт $PORT в интернет/WAN: панель без отдельного пароля."
